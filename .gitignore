# Secrets — never commit
.env
.env.*
*.pem
*.key
*.pfx
secrets.json
credentials.json

# Test-run artifacts (golden_* fixtures ARE tracked — do not ignore)
tests/**/debug.wav
tests/**/*.wav
!tests/**/golden_*.wav
tests/**/_*.png
tests/**/_*.pngb
tests/**/_*.json
tests/**/test-results/
phase19_batch_*/
phase20_hardening/
phase18_run_*.png

# Interrupted-job residue
*.part
*.tmp

# Benchmark run outputs
benchmarks/*.json
benchmark_*.json
bench_*.json

# Coverage
*.gcov
*.gcda
*.gcno
coverage/
lcov.info

# Release packaging outputs (dist/*.ps1 scripts are tracked)
dist/SpectraScope-portable/
dist/*.zip
dist/*.7z
dist/*.tar.gz

# Python (accuracy harness)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Scratch and logs
tmp_formats.txt
*.log

# Agent working notes (regenerable)
